      "speed": 0.98,
      "duration": 9.578666666666667,
      "sha256": "f37e80307d61a81d698ad83216772447caf17cdc1b80faeea5a292ff07f2703f"
    },
    {
      "id": "david-accepts",
      "speaker": "David",
      "text": "I will go, Father. I will take the provisions and bring you news of my brothers.",
      "voice": "am_puck",
      "speed": 1.0,
      "duration": 4.650666666666667,
      "sha256": "8ecd7bf640ff9b2ba0dcdeb5fcf5516b90be8706bf33d3b1689d02f1b6b369ff"
    },
    {
      "id": "jesse-farewell",
      "speaker": "Jesse",
      "text": "Go, my son. May the Lord be with you.",
