    {
      "id": "armour-heavy",
      "speaker": "David",
      "voice": "am_puck",
      "speed": 0.94,
      "text": "They are heavy. My steps do not feel like my own.",
      "duration": 2.7733333333333334,
      "sha256": "01145cd5331648e1eaa4a0d1c113cf540c8dbe2b9c2195231e48d0a5cc1765a1"
    },
    {
      "id": "armour-decline",
      "speaker": "David",
      "voice": "am_puck",
      "speed": 0.94,
      "text": "I cannot go in these. I have never learned to use them.",
      "duration": 3.1146666666666665,
      "sha256": "38ef39b404d7a202f21ab3c675c0eea976fbfeb2513db403b5bff0be3fdb2e47"
    },
    {
      "id": "saul-release",
      "speaker": "Saul",
      "voice": "am_michael",
      "speed": 0.94,
      "text": "Then take what you know. May the Lord go with you.",
      "duration": 3.1573333333333333,
      "sha256": "5d6ca02c697eeb8eb9b2d8395625cc771c1596c1d3e6e0ea77caa9fd380c229b"
    },
    {
      "id": "brook-arrival",
      "speaker": "David",
      "voice": "am_puck",
      "speed": 0.94,
      "text": "Five smooth stones from the brook. My shepherd's sling is enough.",
      "duration": 3.776,
