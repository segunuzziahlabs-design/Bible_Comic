      "speaker": "David",
      "voice": "am_puck",
      "speed": 0.94,
      "text": "Smooth and round. This one will sit well in the sling.",
      "duration": 2.88,
      "sha256": "ce31b889a0a95a3d33abce1f5a251efe47d5b76f4fd14595ff0905c052a13738"
