}, {
"at": 2.0, "shot": "two_shot", "cue": "greet", "line": "Jesse  ·  David, take these provisions to your brothers at the camp."
}, {
"at": 8.0, "shot": "two_shot", "cue": "point", "line": "Jesse  ·  Bring me news of how they are doing."
}, {
"at": 8.5, "cue": "listen"
}, {
