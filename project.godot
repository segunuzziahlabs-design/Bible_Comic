; B05 responsive village proof; the full episode is not implemented.
config_version=5

[application]
config/name="David & Goliath - Village Proof"
run/main_scene="res://scenes/proof/village_proof.tscn"
run/main_scene.toolchain="res://scenes/proof/toolchain_check.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="disabled"
window/dpi/allow_hidpi=false

